<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Hardened runtime entitlements (T-OPS-05). The app is not sandboxed, so no
     App Sandbox entitlements appear here. allow-jit covers Electron/V8;
     audio-input covers the reactive overlay; automation.apple-events covers
     the AX provider where it scripts System Events (T-LIVE-06). -->
<plist version="1.0">
<dict>
  <key>com.apple.security.cs.allow-jit</key>
  <true/>
  <key>com.apple.security.device.audio-input</key>
  <true/>
  <key>com.apple.security.automation.apple-events</key>
  <true/>
</dict>
</plist>
