  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json && vite build && node scripts/build-main.mjs && node scripts/build-preload.mjs && rm -rf dist/electron-tmp",
    "build:renderer": "vite build",
    "build:main": "node scripts/build-main.mjs",
    "build:preload": "node scripts/build-preload.mjs",
    "dev": "vite",
    "test": "vitest run",
    "test:e2e": "playwright test",
