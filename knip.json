{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "includeEntryExports": true,
  "workspaces": {
    ".": {
      "entry": ["tools/**/*.mjs", "scripts/**/*.mjs"],
      "project": ["tools/**/*.mjs", "scripts/**/*.mjs"]
    },
    "apps/desktop": {
      "entry": [
        "electron/main.ts!",
        "electron/preload.ts!",
        "src/app/main.tsx!",
        "src/app/shell.tsx!",
        "scripts/*.mjs",
        "journeys/*.journey.ts"
      ],
      "project": [
        "electron/**/*.ts!",
        "src/**/*.{ts,tsx}!",
        "scripts/*.mjs",
        "journeys/**/*.ts"
      ]
    },
    "packages/*": {
      "entry": ["src/index.ts!"],
      "project": ["src/**/*.ts!"]
    }
  },
  "ignore": ["packages/*/dist/**", "apps/desktop/dist/**"],
  "rules": {
    "files": "error",
    "exports": "error",
    "types": "error",
    "unresolved": "error",
    "unlisted": "error",
    "dependencies": "error",
    "duplicates": "error",
    "cycles": "warn"
  }
}
