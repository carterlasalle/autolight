{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "includeEntryExports": true,
  "workspaces": {
    ".": {
      "entry": ["tools/**/*.mjs", "scripts/**/*.mjs"],
      "project": ["tools/**/*.mjs", "scripts/**/*.mjs"]
    },
    "apps/desktop": {
      "entry": [
        "electron/main.ts!",
        "electron/preload.ts!",
        "src/app/main.tsx!",
        "src/app/shell.tsx!",
        "scripts/*.mjs",
        "journeys/*.journey.ts"
      ],
      "project": [
        "electron/**/*.ts!",
        "src/**/*.{ts,tsx,css}!",
        "scripts/*.mjs",
        "journeys/**/*.ts"
      ]
    },
    "packages/*": {
      "project": ["src/**/*.ts!"]
    }
  },
  "ignoreBinaries": ["osascript", "uv", "tail"],
  "ignoreDependencies": [
    "@knip/language-server",
    "@oxlint/plugins",
    "@tailwindcss/language-server",
    "gitnexus",
    "madge",
    "sql-language-server",
    "typescript-language-server",
    "vscode-langservers-extracted",
    "yaml-language-server"
  ],
  "rules": {
    "files": "error",
    "exports": "error",
    "types": "error",
    "unresolved": "error",
    "unlisted": "error",
    "dependencies": "error",
    "duplicates": "error",
    "cycles": "warn"
  }
}
