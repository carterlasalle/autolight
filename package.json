{
  "name": "autolight",
  "private": true,
  "packageManager": "yarn@4.9.2",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "node scripts/each.mjs run build",
    "test": "node scripts/each.mjs run test",
    "lint": "node scripts/each.mjs run lint",
    "typecheck": "node scripts/each.mjs run typecheck",
    "verify:phase1": "node scripts/each.mjs run typecheck && uv run --project analysis pytest -q"
  },
  "devDependencies": {
    "typescript": "^5.6.3",
    "vitest": "^3.1.0",
    "zod": "^3.23.8"
  }
}
